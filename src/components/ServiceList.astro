---
import type { Service } from "../lib/cms";
import { useTranslations, type Locale } from "../lib/i18n";

interface Props { services: Service[]; locale: Locale; detailed?: boolean; headingLevel?: 2 | 3 }
const { services, locale, detailed = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const t = useTranslations(locale);
---
{services.length === 0 ? (
  <p class="empty">{t("services.empty")}</p>
) : (
  <ul class="services">
    {services.map((service) => (
      <li class:list={["service", { linked: service.page }]}>
        {/* The title link covers the whole row; a service without a published page is listed, but not linked. */}
        <Heading class="title">{service.page ? <a href={service.page.href}>{service.title}</a> : service.title}</Heading>
        {detailed && service.intro ? (
          <div class="text" set:html={service.intro} />
        ) : (
          service.short && <p class="text">{service.short}</p>
        )}
      </li>
    ))}
  </ul>
)}

<style>
  .services {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  /* A register of services: each row is ruled, with the accent tick that marks the start of the line. */
  .service {
    --title-size: clamp(2rem, 1.1rem + 2.8vw, 3.4rem);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: 0.75rem clamp(2rem, 5vw, 4rem);
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-top: 1px solid var(--rule);
  }

  .service::before {
    content: "";
    position: absolute;
    top: -2px;
    left: 0;
    width: 1.5rem;
    height: 3px;
    background: var(--accent);
    transition: width 350ms cubic-bezier(0.2, 0.7, 0.1, 1);
  }

  .title {
    font-size: var(--title-size);
    hyphens: auto;
    transition: color 200ms ease, text-shadow 200ms ease, transform 200ms ease;
  }

  .title a {
    color: inherit;
    text-decoration: none;
    outline: none;
  }

  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  /* The first line of text starts level with the top of the capitals in the title. */
  .text {
    max-width: 34rem;
    padding-top: calc(var(--title-size) * 0.2 - 0.3rem);
    color: var(--slate);
    font-size: var(--step-0);
    line-height: 1.55;
  }

  .text :global(p + p) {
    margin-top: 0.8em;
  }

  /* Pointing at a service extrudes its name along the isometric axis, like the logo, and runs the tick along the rule. */
  .linked:hover::before,
  .linked:has(a:focus-visible)::before {
    width: 100%;
  }

  .linked:hover .title,
  .linked:has(a:focus-visible) .title {
    color: var(--cobalt);
    transform: translate(-3px, -1.5px);
    text-shadow:
      1px 0.5px 0 var(--extrude), 2px 1px 0 var(--extrude), 3px 1.5px 0 var(--extrude),
      4px 2px 0 var(--extrude), 5px 2.5px 0 var(--extrude), 6px 3px 0 var(--extrude);
  }

  .linked:has(a:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 6px;
  }

  .empty {
    max-width: var(--measure);
    padding: 1.5rem;
    border: 1px dashed var(--extrude);
    color: var(--slate);
  }

  @media (max-width: 48rem) {
    .service {
      grid-template-columns: 1fr;
    }

    .text {
      padding-top: 0;
    }
  }
</style>
