---
import Base from "../layouts/Base.astro";
import ContactBand from "../components/ContactBand.astro";
import type { PageProps } from "../lib/routes";
import { path, useTranslations, type Locale } from "../lib/i18n";

type Props = PageProps & { locale: Locale };
const { locale, page, service, otherServices, alternates } = Astro.props;
const t = useTranslations(locale);
// A page linked from a service is shown as that service: its title, intro and the other services.
const title = service?.title ?? page.title;
---
<Base locale={locale} section={service ? "services" : undefined} title={title} description={service?.short ?? undefined} alternates={alternates} image={page.cover?.src}>
  <article>
    <header class="wrap head">
      {service && <a class="crumb" href={path("services", locale)}>{t("nav.services")}</a>}
      <h1>{title}</h1>
      {service?.intro ? <div class="lead" set:html={service.intro} /> : service?.short && <p class="lead">{service.short}</p>}
    </header>

    <div class:list={["wrap body", { "has-cover": page.cover }]}>
      {page.content && <div class="prose" set:html={page.content} />}
      {page.cover && (
        <figure class="cover">
          <img src={page.cover.src} width={page.cover.width} height={page.cover.height} alt="" />
        </figure>
      )}
    </div>
  </article>

  {otherServices.some((other) => other.page) && (
    <nav class="wrap others" aria-labelledby="others-title">
      <h2 id="others-title">{t("service.other")}</h2>
      <ul>
        {otherServices.map((other) => other.page && (
          <li>
            <a href={other.page.href}>{other.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  {service ? <ContactBand locale={locale} heading={t("service.cta")} body={t("service.ctaBody")} /> : <ContactBand locale={locale} />}
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .crumb {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--slate);
    font-weight: 600;
    text-decoration-color: var(--accent);
  }

  h1 {
    font-size: var(--step-5);
  }

  .lead {
    max-width: 40rem;
    margin-top: 1.75rem;
    color: var(--slate);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .body {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .body.has-cover {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
  }

  .cover {
    --side: var(--extrude);
    margin: 0 12px 0 0;
    box-shadow:
      2px 1px 0 var(--side), 4px 2px 0 var(--side), 6px 3px 0 var(--side),
      8px 4px 0 var(--side), 10px 5px 0 var(--side), 12px 6px 0 var(--side);
  }

  .cover img {
    width: 100%;
  }

  .others {
    padding-block: 2.5rem clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--rule);
  }

  .others h2 {
    font-size: var(--step-1);
  }

  .others ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .others a {
    font-size: var(--step-2);
    font-variation-settings: var(--display);
    font-weight: 750;
    text-decoration: none;
  }

  .others a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
  }

  @media (max-width: 52rem) {
    .body.has-cover {
      grid-template-columns: 1fr;
    }

    .cover {
      grid-row: 1;
    }
  }
</style>
