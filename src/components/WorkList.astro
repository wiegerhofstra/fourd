---
import { Image } from "astro:assets";
import { projects } from "../lib/work";
import { useTranslations, type Locale } from "../lib/i18n";

interface Props { locale: Locale; headingLevel?: 2 | 3 }
const { locale, headingLevel = 2 } = Astro.props;
const t = useTranslations(locale);
const Heading = `h${headingLevel}` as "h2" | "h3";
const list = new Intl.ListFormat(locale, { type: "conjunction" });
---
<ul class="projects">
  {projects.map((project, index) => (
    <li class="project">
      <div class="frame">
        <Image src={project.image} alt="" widths={[480, 800, 1200]} sizes="(min-width: 56rem) 40rem, 100vw" loading={index === 0 ? "eager" : "lazy"} />
      </div>
      <div class="info">
        <Heading>{project.name}</Heading>
        <p>{project.description[locale]}</p>
        {project.partners.length > 0 && <p class="partners">{t("work.with")} {list.format(project.partners)}.</p>}
      </div>
    </li>
  ))}
</ul>

<style>
  .projects {
    display: grid;
    gap: clamp(3.5rem, 8vw, 6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4.5rem);
  }

  .project:nth-child(even) .frame {
    order: 2;
  }

  /* Screens sit on a slab extruded like the logo. */
  .frame {
    --side: var(--extrude);
    margin-right: 12px;
    background: var(--paper-raised);
    box-shadow:
      2px 1px 0 var(--side), 4px 2px 0 var(--side), 6px 3px 0 var(--side),
      8px 4px 0 var(--side), 10px 5px 0 var(--side), 12px 6px 0 var(--side);
  }

  .frame img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  h2,
  h3 {
    font-size: var(--step-3);
  }

  .info p {
    margin-top: 1rem;
    max-width: 32rem;
    color: var(--slate);
  }

  .info .partners {
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    font-size: var(--step--1);
  }

  @media (max-width: 48rem) {
    .project {
      grid-template-columns: 1fr;
    }

    .project:nth-child(even) .frame {
      order: 0;
    }
  }
</style>
