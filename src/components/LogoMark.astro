---
import { logoFaces, logoViewBox } from "../lib/logo";

interface Props { class?: string; title?: string }
// `rest` carries the parent's scoped-style attribute so its styles reach this element.
const { class: className, title, ...rest } = Astro.props;
---
<svg class={className} {...rest} viewBox={`0 0 ${logoViewBox.width} ${logoViewBox.height}`} role={title ? "img" : undefined} aria-hidden={title ? undefined : "true"} aria-label={title}>
  {logoFaces.map((face) => <polygon points={face.points} style={`fill: ${face.fill}; stroke: ${face.fill}`} stroke-width="0.02" stroke-linejoin="round" />)}
  <!-- At small sizes the edges keep a fixed pixel width so they stay crisp. -->
  {logoFaces.map((face) => <polygon class="edge" points={face.points} style={`stroke: ${face.line}`} vector-effect="non-scaling-stroke" />)}
</svg>

<style>
  .edge {
    fill: none;
    stroke-width: var(--logo-line-width, 1.25px);
    stroke-linejoin: round;
  }
</style>
