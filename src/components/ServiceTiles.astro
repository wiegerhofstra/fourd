---
import ServiceIcon from "./ServiceIcon.astro";
import type { Service } from "../lib/cms";
import { useTranslations, type Locale } from "../lib/i18n";

interface Props { services: Service[]; locale: Locale; detailed?: boolean; headingLevel?: 2 | 3 }
const { services, locale, detailed = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
// Two columns for an even count, three for odd counts, so the grid has as few gaps as possible.
const columns = services.length % 2 === 0 ? 2 : Math.min(services.length, 3);
const t = useTranslations(locale);
---
{services.length === 0 ? (
  <p class="empty">{t("services.empty")}</p>
) : (
  <ul class="tiles" style={`--columns: ${columns}; --columns-medium: ${Math.min(columns, 2)}`}>
    {services.map((service) => {
      // A service without a published page is shown, but not linked.
      const Tile = service.page ? "a" : "div";
      return (
        <li>
          <Tile class="tile" href={service.page?.href}>
            <ServiceIcon slug={service.page?.slug ?? ""} class="icon" />
            <Heading>{service.title}</Heading>
            {detailed && service.intro ? (
              <div class="text" set:html={service.intro} />
            ) : (
              service.short && <p class="text">{service.short}</p>
            )}
            {service.page && <span class="more">{t("services.more")} {service.title.toLowerCase()}</span>}
          </Tile>
        </li>
      );
    })}
  </ul>
)}

<style>
  .tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.75rem 2.5rem;
    margin: 0;
    padding: 0 12px 6px 0;
    list-style: none;
  }

  @media (min-width: 44rem) {
    .tiles {
      grid-template-columns: repeat(var(--columns-medium), minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .tiles {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }
  }

  /* Each tile is a raised slab: its side and bottom faces are extruded along the isometric axis. */
  .tile {
    --side: var(--face-mid);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
    padding: 2rem 2rem 1.75rem;
    background: var(--paper-raised);
    container-type: inline-size;
    outline-offset: 10px;
    text-decoration: none;
    box-shadow:
      2px 1px 0 var(--side), 4px 2px 0 var(--side), 6px 3px 0 var(--side),
      8px 4px 0 var(--side), 10px 5px 0 var(--side), 12px 6px 0 var(--side);
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.1, 1), box-shadow 200ms cubic-bezier(0.2, 0.7, 0.1, 1);
  }

  a.tile:hover {
    --side: var(--slate);
    transform: translate(-4px, -2px);
    box-shadow:
      2px 1px 0 var(--side), 4px 2px 0 var(--side), 6px 3px 0 var(--side),
      8px 4px 0 var(--side), 10px 5px 0 var(--side), 12px 6px 0 var(--side),
      14px 7px 0 var(--side), 16px 8px 0 var(--side);
  }

  a.tile:active {
    transform: translate(4px, 2px);
  }

  .icon {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--rose-deep);
  }

  h2,
  h3 {
    /* Long Dutch words such as "Automatisering" shrink to fit narrow tiles instead of overflowing. */
    font-size: min(var(--step-3), calc(100cqi / 10.5));
    hyphens: auto;
  }

  .text {
    max-width: 34rem;
    color: var(--slate);
  }

  .text :global(p + p) {
    margin-top: 0.8em;
  }

  .more {
    margin-top: auto;
    padding-top: 0.75rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--rose);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .empty {
    max-width: var(--measure);
    padding: 1.5rem;
    border: 1px dashed var(--face-mid);
    color: var(--slate);
  }
</style>
