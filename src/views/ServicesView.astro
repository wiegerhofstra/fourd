---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import ServiceList from "../components/ServiceList.astro";
import ContactBand from "../components/ContactBand.astro";
import { getServices } from "../lib/cms";
import { path, useTranslations, type Locale } from "../lib/i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const services = await getServices(locale);
---
<Base locale={locale} section="services" title={t("nav.services")} description={t("services.intro")} alternates={{ nl: path("services", "nl"), en: path("services", "en") }}>
  <PageIntro title={t("nav.services")} lead={t("services.intro")} />
  <section class="wrap list">
    <ServiceList services={services} locale={locale} detailed headingLevel={2} />
  </section>
  <ContactBand locale={locale} heading={t("service.cta")} body={t("service.ctaBody")} />
</Base>

<style>
  .list {
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
</style>
