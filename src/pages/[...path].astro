---
import type { GetStaticPaths } from "astro";
import PageView from "../views/PageView.astro";
import { getPagePaths, type StaticPageProps } from "../lib/routes";

export const getStaticPaths = (() => getPagePaths("nl")) satisfies GetStaticPaths;
type Props = StaticPageProps;
const { pageProps, redirect } = Astro.props;
if (redirect) return Astro.redirect(redirect, 308);
---
{pageProps && <PageView locale="nl" {...pageProps} />}
