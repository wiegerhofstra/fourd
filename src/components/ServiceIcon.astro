---
// Line icons for the known services, keyed by CMS slug. Unknown services get an isometric cube.
interface Props { slug: string; class?: string }
const { slug, class: className, ...rest } = Astro.props;

const icons: Record<string, string> = {
  // A puzzle piece: software that fits exactly.
  maatwerk: "M4 8h3.5a2.5 2.5 0 0 1 5 0H16v3.5a2.5 2.5 0 0 1 0 5V20H4V8Z",
  // Two interlocking arrows: a recurring process that runs by itself.
  automatisering: "M5 11a7 7 0 0 1 12.2-4.7M19 6v3.5h-3.5M19 13a7 7 0 0 1-12.2 4.7M5 18v-3.5h3.5",
  // A browser window.
  website: "M3.5 5.5h17v13h-17zM3.5 9.5h17M6.5 7.5h.01M8.8 7.5h.01",
  // A phone.
  "mobile-apps": "M7.5 3h9v18h-9zM11 18h2",
  applicaties: "M7.5 3h9v18h-9zM11 18h2",
};
const fallback = "M12 3l7.8 4.5v9L12 21l-7.8-4.5v-9L12 3Zm0 9l7.8-4.5M12 12v9M12 12L4.2 7.5";
---
<svg class={className} {...rest} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={icons[slug] ?? fallback} />
</svg>
